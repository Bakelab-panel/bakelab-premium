---
import HomeExperience from '@components/HomeExperience.astro';
import PremiumLayout from '@layouts/PremiumLayout.astro';
import { getHomeProjects } from '@lib/project-store';
import { sitePt } from '@data/site.pt';

const projects = await getHomeProjects();
---

<PremiumLayout site={sitePt} alternateHref="/en">
  <HomeExperience site={sitePt} projects={projects} />
</PremiumLayout>
