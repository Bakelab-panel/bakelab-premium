---
import ProjectDetail from '@components/ProjectDetail.astro';
import PremiumLayout from '@layouts/PremiumLayout.astro';
import { getCopy } from '@data/projects';
import { getProjectBySlug } from '@lib/project-store';
import { siteEn } from '@data/site.en';
const slug = Astro.params.slug ?? '';
const project = slug ? await getProjectBySlug(slug) : null;
const copy = project ? getCopy(project, 'en') : null;
---

{
  project && copy ? (
    <PremiumLayout
      site={siteEn}
      title={`${copy.title} — !bakelab`}
      description={copy.description}
      image={project.cover ?? siteEn.seo.image}
      alternateHref={`/pt/projetos/${project.slug}`}
    >
      <ProjectDetail site={siteEn} project={project} />
    </PremiumLayout>
  ) : (
    (() => {
      Astro.response.status = 404;
      return (
        <PremiumLayout site={siteEn} title="Project not found — !bakelab" description="The requested project is not available.">
          <section class="container-px premium-section pt-24">
            <p class="eyebrow">404</p>
            <h1 class="mt-4 display-title">Project not found</h1>
            <p class="mt-5 max-w-2xl text-lg leading-8 text-mist">This project is unavailable or has been disabled in the admin panel.</p>
          </section>
        </PremiumLayout>
      );
    })()
  )
}
